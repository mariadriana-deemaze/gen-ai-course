# Keep this file safe on your own computer. Never commit your real key.
OPENAI_API_KEY=

# This is a default for the class. It can be changed in a local .env file.
OPENAI_MODEL=gpt-4.1-mini

# Any server speaking the OpenAI chat protocol. The OpenAI client reads
# OPENAI_BASE_URL itself, so no code changes.
#
# A local model (FreeToken, vLLM, Ollama, LM Studio):
# OPENAI_API_KEY=freetoken-local
# OPENAI_MODEL=Qwen3.6-35B-A3B-NVFP4
# OPENAI_BASE_URL=http://127.0.0.1:1919/v1
#
# The Anthropic API, through its OpenAI-compatible endpoint:
# OPENAI_API_KEY=<your Anthropic key>
# OPENAI_MODEL=claude-opus-5
# OPENAI_BASE_URL=https://api.anthropic.com/v1/
